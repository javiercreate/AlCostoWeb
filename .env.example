# ==========================================================================
# Variables de la API (/api/orders) — se configuran en Vercel:
# Project → Settings → Environment Variables (NO en el navegador).
# ==========================================================================

# URL del proyecto Supabase, sin barra final.
SUPABASE_URL=https://tuproyecto.supabase.co

# service_role key (Project Settings → API). NUNCA se expone al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Radio máximo de reparto en kilómetros (opcional, por defecto 15).
MAX_DELIVERY_KM=15

# Webhook opcional de n8n para avisar cada pedido nuevo (opcional).
# N8N_WEBHOOK_URL=https://tu-n8n.app.n8n.cloud/webhook/pedido-nuevo
